{
  "compilerOptions": {
    "module": "Node16",
   "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "sourceMap": false,
    "outDir": "dist",
    "baseUrl": ".",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "*": [
        "node_modules/*",
        "src/interfaces/*"
      ]
    },
    "lib": [
      "es2015", "es5", "es6", "dom"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*"
  ]
}
